# ---- NoneBot 运行参数 ----
DRIVER=~fastapi
HOST=127.0.0.1
PORT=8081
LOG_LEVEL=INFO
# 管理员 QQ（用于 /model 管理指令），JSON 数组；替换为你自己的主 QQ 号
SUPERUSERS=["<你的主QQ号>"]

# ---- 业务配置（core/config.py 读取）----
# 允许响应的群号，英文逗号分隔；留空 = 所有群都不响应（安全默认）
ALLOWED_GROUP_IDS=<测试群号>
BOT_NAME=十九
BOT_QQ=123456789

# ---- LLM 总开关与主选后端 ----
LLM_ENABLED=1
LLM_PROVIDER=local
# 失败回退顺序（可留空）：例如 local
LLM_FALLBACKS=
# 聊天触发方式：command=仅/chat；mention=仅@机器人与引用回复（默认）；all=所有非命令消息都聊
LLM_REPLY_MODE=mention
# 输出预算：思考+正文都从这里出；开思考后别设太小
LLM_MAX_TOKENS=100000
LLM_COOLDOWN=5
# 开思考后单次可能 5–30 秒
LLM_TIMEOUT=180

# ---- Token 预算：单日上限 + 超限提示语 ----
LLM_DAILY_TOKEN_LIMIT=10000000
LLM_QUOTA_REPLY=白饭吃完了QAQ
LLM_TOOL_MAX_ROUNDS=3
# 开启后回复附 [via <后端名>]（排查/演示用）
LLM_SHOW_PROVIDER=0
# 开启后回复附"思考节选"（默认关）
LLM_SHOW_REASONING=0
# ---- LLM 人设（system prompt，留空=无人设）----
# 方式一：人设文件（相对路径基于 bot/ 目录）
# LLM_PERSONA_FILE=persona.md
# 方式二：单行直写（支持 
 转义；优先级高于文件）
# LLM_SYSTEM_PROMPT=你是群友十九，说话自然简洁，不发嗲不卖萌……

# ---- 后端 1：本机 llama.cpp（免费、隐私）----
LLM_LOCAL_BASE_URL=http://127.0.0.1:8080/v1
LLM_LOCAL_MODEL=qwen
LLM_LOCAL_API_KEY=

# ---- 后端 2：opencode-go 中转（订阅制；注意额度消耗；思考默认开）----
LLM_OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1
LLM_OPENCODE_GO_MODEL=deepseek-v4.1-flash
LLM_OPENCODE_GO_API_KEY=
LLM_OPENCODE_GO_THINKING=on
LLM_OPENCODE_GO_REASONING_EFFORT=high

# ---- function calling（web_search 工具，LLM 按需调用）----
LLM_OPENCODE_GO_TOOLS=on
LLM_LOCAL_TOOLS=off

# ---- 网络搜索（Firecrawl；/search 手动触发 或 LLM 按需调用）----
SEARCH_ENABLED=1
SEARCH_API_KEY=
SEARCH_MAX_RESULTS=5
SEARCH_TIMEOUT=30

# ---- 群上下文与图片感知（感知层）----
# 回复时附带的最近群聊条数（0=关闭上下文注入）
LLM_CONTEXT_MESSAGES=12
# 图片识别：opencode-go 云 vision 为主，本地 MiniCPM-V 兜底（VISION_LOCAL_URL 留空=不用本地）
VISION_ENABLED=1
VISION_MODEL=deepseek-v4-flash-vision-exp
VISION_LOCAL_URL=http://127.0.0.1:8082/v1

# ---- 表达层：表情包回应 ----
# LLM 可调用 send_sticker 发送图库里的表情包（图库自动从群消息图片收集）
STICKER_ENABLED=1

# ---- 表达层：引用回复 ----
# 聊天回复自动引用触发消息（一眼看清在回谁）
QUOTE_REPLY_ENABLED=1

# ---- 决策层：主动接话（不@也会回复）----
# 概率门（普通消息被判断接话的机会）+ 每群冷却秒数；提到机器人名字的消息必判
AUTO_REPLY_ENABLED=1
AUTO_REPLY_CHANCE=0.35
AUTO_REPLY_COOLDOWN=240

# ---- 记忆系统：长期记忆（人物档案/群事件）----
# 后台每 MEMORY_TICK 秒检查一次；攒够一批消息调用 LLM 提炼；回复时自动注入相关记忆
MEMORY_ENABLED=1
MEMORY_BATCH=30
MEMORY_TICK=120

# ---- 情绪系统：心情状态 ----
# 后台每 MOOD_TICK 秒综合互动整理一次心情（随时间衰减回平静）；回复时自然带上；发图综合心情×话题×内容
MOOD_ENABLED=1
MOOD_TICK=600

# ---- 风格学习：few-shot 对话对（学"自己怎么说话"，零 LLM 成本）----
# 后台每 STYLE_TICK 秒从真实「用户→Bot」对话对提取风格样本；回复时注入相似场合的样例供模仿
STYLE_ENABLED=1
STYLE_TICK=300

# ---- 黑话学习：群内黑话（统计预筛 + LLM 推断含义）----
# 后台每 JARGON_TICK 秒零成本预筛群内特有词，有候选才问 LLM；含黑话的消息会被解释注入（只理解不复读）
JARGON_ENABLED=1
JARGON_TICK=600

# ---- 好感度：守恒制（单用户 0-100，群总 250）----
# 互动自动加减（夸赞/感谢加分、坏话扣分，受心情修正；久不聊自然衰减）；回复时带"关系"块；/affection 管理
AFFECTION_ENABLED=1

# ---- 人格演化：学习补充审查 ----
# 有足够新素材时生成"人设补充建议"进待审队列；管理员 /persona review 批准才生效（不改 md 原文，可回滚）
PERSONA_EVO_ENABLED=1
PERSONA_EVO_TICK=86400

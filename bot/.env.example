# ---- NoneBot 运行参数 ----
DRIVER=~fastapi
HOST=127.0.0.1
PORT=8081
LOG_LEVEL=INFO
# 管理员 QQ（用于 /model 管理指令），JSON 数组；替换为你自己的主 QQ 号
SUPERUSERS=["<你的主QQ号>"]

# ---- 业务配置（core/config.py 读取）----
# 允许响应的群号，英文逗号分隔；留空 = 所有群都不响应（安全默认）
ALLOWED_GROUP_IDS=<测试群号>
BOT_NAME=十九

# ---- LLM 总开关与主选后端 ----
LLM_ENABLED=1
LLM_PROVIDER=local
# 失败回退顺序（可留空）：例如 deepseek,opencode_go
LLM_FALLBACKS=deepseek,opencode_go
# 聊天触发方式：command=仅/chat；mention=仅@机器人与引用回复（默认）；all=所有非命令消息都聊
LLM_REPLY_MODE=mention
# 输出预算：思考+正文都从这里出；开思考后别设太小
LLM_MAX_TOKENS=100000
LLM_COOLDOWN=5
# 开思考后单次可能 5–30 秒
LLM_TIMEOUT=180

# ---- Token 预算：单日上限 + 超限提示语 ----
LLM_DAILY_TOKEN_LIMIT=10000000
LLM_QUOTA_REPLY=白饭吃完了QAQ
LLM_TOOL_MAX_ROUNDS=3
# 开启后回复附 [via <后端名>]（排查/演示用）
LLM_SHOW_PROVIDER=0
# 开启后回复附"思考节选"（默认关）
LLM_SHOW_REASONING=0
# ---- LLM 人设（system prompt，留空=无人设）----
# 方式一：人设文件（相对路径基于 bot/ 目录）
# LLM_PERSONA_FILE=persona.md
# 方式二：单行直写（支持 
 转义；优先级高于文件）
# LLM_SYSTEM_PROMPT=你是群友十九，说话自然简洁，不发嗲不卖萌……

# ---- 后端 1：本机 llama.cpp（免费、隐私）----
LLM_LOCAL_BASE_URL=http://127.0.0.1:8080/v1
LLM_LOCAL_MODEL=qwen
LLM_LOCAL_API_KEY=

# ---- 后端 2：DeepSeek 官方 API（思考默认开）----
LLM_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
LLM_DEEPSEEK_MODEL=deepseek-flash
LLM_DEEPSEEK_API_KEY=
# on=开思考（默认）；off=关
LLM_DEEPSEEK_THINKING=on
# 思考档位：low / medium / high / max（xhigh 自动映射为 max）
LLM_DEEPSEEK_REASONING_EFFORT=high

# ---- 后端 3：opencode-go 中转（订阅制；注意额度消耗；思考默认开）----
LLM_OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1
LLM_OPENCODE_GO_MODEL=deepseek-v4.1-flash
LLM_OPENCODE_GO_API_KEY=
LLM_OPENCODE_GO_THINKING=on
LLM_OPENCODE_GO_REASONING_EFFORT=high

# ---- function calling（web_search 工具，LLM 按需调用）----
LLM_OPENCODE_GO_TOOLS=on
LLM_DEEPSEEK_TOOLS=on
LLM_LOCAL_TOOLS=off

# ---- 网络搜索（Firecrawl；/search 手动触发 或 LLM 按需调用）----
SEARCH_ENABLED=1
SEARCH_API_KEY=
SEARCH_MAX_RESULTS=5
SEARCH_TIMEOUT=30
